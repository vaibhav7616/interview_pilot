{
  "name": "interview-pilot",
  "productName": "Interview Pilot",
  "version": "1.0.0",
  "description": "Real-time AI interview and meeting copilot for Windows",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/stt.js && node --check src/ai.js && node --check src/store.js && node --check src/preload.js && node --check src/renderer/app.js && node --check src/renderer/pcm-worklet.js",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:win-zip": "electron-builder --win zip --x64"
  },
  "build": {
    "appId": "com.codetrade.interviewpilot",
    "productName": "Interview Pilot",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "dompurify": "^3.4.18",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
