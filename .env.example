# Copy this file to .env and fill in your keys. .env is loaded automatically at startup
# and overrides keys entered in Settings. Never commit .env.

# Google Gemini (free tier) — https://aistudio.google.com
GEMINI_API_KEY=

# Deepgram live transcription — https://console.deepgram.com
DEEPGRAM_API_KEY=

# Optional: only needed if you select a Claude model in Settings
ANTHROPIC_API_KEY=

# Groq (free tier, fastest answers) — https://console.groq.com
GROQ_API_KEY=
